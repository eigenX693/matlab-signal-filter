% Custom Signal Filtering & Sensor Noise Reduction
% Standard .m script version for MATLAB Mobile

clear; clc; close all;

% 1. Data Ingestion & Normalization
[rawSignal, fs] = audioread('noisysignal.wav');

if size(rawSignal, 2) > 1
    rawSignal = mean(rawSignal, 2);
end

rawSignal = rawSignal / max(abs(rawSignal));

% 2. Vectorized Indexing (Sliding-Window Moving Average Filter)
windowSize = 25; 
halfWindow = floor(windowSize / 2);

paddedSignal = padarray(rawSignal, [halfWindow, 0], 'replicate', 'both');

cumsumSignal = cumsum([0; paddedSignal]);
filteredSignal = (cumsumSignal(windowSize + 1:end) - cumsumSignal(1:end - windowSize)) / windowSize;

filteredSignal = filteredSignal(1:length(rawSignal));

% 3. Data Visualization
timeVector = (0:length(rawSignal)-1) / fs;

figure('Name', 'Signal Noise Reduction', 'Color', 'w');

% Subplot 1: Raw Noisy Sensor Signal
subplot(2, 1, 1);
plot(timeVector, rawSignal, 'Color', [0.85, 0.33, 0.1], 'LineWidth', 1);
title('Raw Sensor Signal');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;
xlim([timeVector(1), timeVector(end)]);

% Subplot 2: Filtered Smooth Signal
subplot(2, 1, 2);
plot(timeVector, filteredSignal, 'Color', [0, 0.45, 0.74], 'LineWidth', 1.2);
title('Filtered Signal (Moving Average)');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;
xlim([timeVector(1), timeVector(end)]);